# MongoDB connection string
# Replace <username>, <password>, and <dbname> with your actual credentials
MONGODB_URI=mongodb://localhost:27017/examseat

# JWT secret key - change this to a long random string in production
JWT_SECRET=examseat_super_secret_jwt_key_change_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Teacher registration code (same as the hardcoded one in auth.js)
TEACHER_REGISTRATION_CODE=EXAMSEAT-TEACHER
